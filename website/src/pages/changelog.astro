---
import { getCollection, render } from "astro:content";

import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Brushmark from "../components/Brushmark.astro";

// The app's CHANGELOG.md, as it is when the site is built (see `content.config.ts`)
const [changelog] = await getCollection("changelog");
const { Content, headings } = await render(changelog);

// Each version is a `### <version>` heading; the sidebar links to them, newest first
const versionParts = (text: string) => text.replace(/^v/, "").split(".").map((part) => Number.parseInt(part, 10) || 0);
const versions = headings
  .filter((heading) => heading.depth === 3)
  .map(({ slug, text }) => ({ slug, text }))
  .sort((a, b) => {
    const [x, y] = [versionParts(a.text), versionParts(b.text)];
    for (let i = 0; i < Math.max(x.length, y.length); i++) {
      if ((y[i] ?? 0) !== (x[i] ?? 0)) return (y[i] ?? 0) - (x[i] ?? 0);
    }
    return 0;
  });
---

<html lang="en" class="no-js">
  <head>
    <BaseHead title="Changelog · enso" description="What's new in enso, version by version." />
  </head>
  <body>
    <Header />
    <main class="page container">
      <header class="head">
        <Brushmark name="write" class="head-mark" />
        <h1 class="display">What's new in enso</h1>
      </header>

      <div class="layout">
        <nav class="versions" aria-label="Versions">
          <span class="eyebrow versions-title">Versions</span>
          <ul>
            {
              versions.map((version, index) => (
                <li>
                  <a href={`#${version.slug}`} data-version={version.slug} aria-current={index === 0 ? "true" : undefined}>
                    {version.text}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <article class="changelog">
          <Content />
        </article>
      </div>
    </main>
    <Footer />

    <script is:inline>
      // The version being read is marked beside the changelog
      (() => {
        const nav = document.querySelector(".versions");
        const links = [...document.querySelectorAll(".versions a")];
        const reveal = (link) => {
          const box = nav.getBoundingClientRect();
          const item = link.getBoundingClientRect();
          if (item.left < box.left) nav.scrollLeft -= box.left - item.left + 24;
          else if (item.right > box.right) nav.scrollLeft += item.right - box.right + 24;
        };
        const slugs = new Set(links.map((link) => link.dataset.version));
        const headings = [...document.querySelectorAll(".changelog h3")].filter((h) => slugs.has(h.id));
        if (!headings.length) return;
        let current = null;
        const update = () => {
          const line = window.innerHeight * 0.3;
          let found = headings[0];
          for (const heading of headings) if (heading.getBoundingClientRect().top <= line) found = heading;
          if (found.id === current) return;
          current = found.id;
          links.forEach((link) => {
            if (link.dataset.version === current) {
              link.setAttribute("aria-current", "true");
              reveal(link);
            } else link.removeAttribute("aria-current");
          });
        };
        update();
        window.addEventListener("scroll", update, { passive: true });
      })();
    </script>
  </body>
</html>

<style>
  .page {
    padding-top: 150px;
    padding-bottom: 120px;
  }
  .head {
    display: grid;
    justify-items: center;
    text-align: center;
  }
  .head-mark {
    margin-bottom: 18px;
  }
  .head h1 {
    font-size: clamp(38px, 5.4vw, 60px);
  }

  .layout {
    display: grid;
    grid-template-columns: 180px minmax(0, 720px);
    justify-content: center;
    gap: 72px;
    margin-top: 80px;
  }

  .versions {
    position: sticky;
    top: 110px;
    align-self: start;
  }
  .versions-title {
    display: block;
    margin-bottom: 16px;
  }
  .versions ul {
    list-style: none;
    border-left: 1px solid var(--line);
  }
  .versions a {
    display: block;
    margin-left: -1px;
    padding: 6px 0 6px 18px;
    border-left: 2px solid transparent;
    font-family: var(--font-display);
    font-size: 17px;
    font-variant-numeric: tabular-nums;
    color: var(--ink-soft);
    transition:
      color 0.3s var(--ease),
      border-color 0.3s var(--ease);
  }
  .versions a:hover {
    color: var(--ink);
  }
  .versions a[aria-current="true"] {
    color: var(--ink);
    border-left-color: var(--accent);
  }

  .changelog {
    min-width: 0;
    font-size: 15.5px;
    line-height: 1.7;
    color: var(--ink-muted);
  }
  .changelog :global(h1) {
    display: none;
  }
  .changelog :global(h3) {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 72px 0 8px;
    padding-top: 56px;
    border-top: 1px solid var(--line);
    font-family: var(--font-display);
    font-size: 36px;
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--ink);
    scroll-margin-top: 90px;
  }
  .changelog :global(h3:first-of-type) {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }
  /* The newest version */
  .changelog :global(h3:first-of-type)::after {
    content: "Latest";
    padding: 3px 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-ink);
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    border-radius: 999px;
  }
  /* "Features:", "Enhancements:", "Bug Fixes:" */
  .changelog :global(p) {
    margin: 30px 0 4px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .changelog :global(ul) {
    list-style: none;
  }
  .changelog :global(li) {
    position: relative;
    padding: 12px 0 12px 22px;
    border-bottom: 1px solid var(--line);
  }
  .changelog :global(li)::before {
    content: "";
    position: absolute;
    left: 2px;
    top: 23px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    border: 1.2px solid var(--ink-faint);
  }
  .changelog :global(strong) {
    font-weight: 600;
    color: var(--ink);
  }
  .changelog :global(code) {
    padding: 1px 6px;
    font-family: var(--font-mono);
    font-size: 13px;
    border-radius: 6px;
    background: var(--paper-sunk);
    border: 1px solid var(--line);
  }

  @media (max-width: 900px) {
    .page {
      padding-top: 110px;
    }
    .layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
      margin-top: 48px;
    }
    .versions {
      top: 58px;
      z-index: 10;
      margin: 0 calc(var(--gutter) * -1);
      padding: 10px var(--gutter);
      overflow-x: auto;
      scrollbar-width: none;
      background: color-mix(in srgb, var(--paper) 86%, transparent);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
    }
    .versions-title {
      display: none;
    }
    .versions ul {
      display: flex;
      gap: 6px;
      width: max-content;
      border-left: 0;
    }
    .versions a {
      margin: 0;
      padding: 4px 14px;
      font-size: 15px;
      border: 1px solid var(--line);
      border-radius: 999px;
    }
    .versions a[aria-current="true"] {
      border-color: var(--ink);
    }
    .changelog :global(h3) {
      font-size: 30px;
      scroll-margin-top: 130px;
    }
  }
</style>
