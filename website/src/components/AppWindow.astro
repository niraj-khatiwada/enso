---
/**
 * enso's window, rebuilt in HTML so it is crisp at every size and follows the page's theme: the
 * titlebar with its tabs, the workspace sidebar, the outline rail and the status bar. Read, Edit
 * and Split switch it the way the app does.
 */

const files = [
  { name: "Journal", folder: true, open: true, depth: 0 },
  { name: "2026-11-03.md", depth: 1 },
  { name: "2026-11-04.md", depth: 1 },
  { name: "Get Started.md", depth: 0, active: true },
  { name: "Ideas.md", depth: 0 },
  { name: "Reading List.md", depth: 0 },
  { name: "Recipes", folder: true, depth: 0 },
];

/** The document's source, one line per entry; `kind` tints it the way the editor does */
const source: { text: string; kind?: "h1" | "h2" | "quote" | "task" | "fence" | "code" | "blank" }[] = [
  { text: "# A little space for your thoughts.", kind: "h1" },
  { text: "", kind: "blank" },
  { text: "Welcome to **enso**, a quiet home for your" },
  { text: "Markdown and text files. Changes save" },
  { text: "automatically." },
  { text: "", kind: "blank" },
  { text: "## Read. Write. Make room.", kind: "h2" },
  { text: "", kind: "blank" },
  { text: "> Simplicity is the space where ideas", kind: "quote" },
  { text: "> take shape.", kind: "quote" },
  { text: "", kind: "blank" },
  { text: "- [x] Open a folder", kind: "task" },
  { text: "- [ ] Draft the essay", kind: "task" },
  { text: "- [ ] Sketch the flow", kind: "task" },
  { text: "", kind: "blank" },
  { text: "```mermaid", kind: "fence" },
  { text: "flowchart LR", kind: "code" },
  { text: "  Idea --> Draft --> Share", kind: "code" },
  { text: "```", kind: "fence" },
];

/** Splits Markdown punctuation from the words, so it can be dimmed like the editor does */
function tokens(line: string): { text: string; mark: boolean }[] {
  const parts = line.split(/(\*\*|^#+ |^> |^- \[[ x]\] |```)/g).filter(Boolean);
  return parts.map((text) => ({ text, mark: /^(\*\*|#+ |> |- \[[ x]\] |```)$/.test(text) }));
}

const outline = [
  { level: 1, title: "A little space for your thoughts." },
  { level: 2, title: "Read. Write. Make room." },
];
---

<div class="app" data-view="read">
  <div class="switch" role="tablist" aria-label="View">
    <span class="switch-pill" aria-hidden="true"></span>
    <button role="tab" data-to="read" aria-selected="true">Read <kbd><span class="mod">⌘</span>E</kbd></button>
    <button role="tab" data-to="edit" aria-selected="false">Edit <kbd><span class="mod">⌘</span>E</kbd></button>
    <button role="tab" data-to="split" aria-selected="false">Split <kbd><span class="mod">⌘</span>\</kbd></button>
  </div>

  <div class="window" aria-label="The enso window">
    <div class="titlebar">
      <div class="lights" aria-hidden="true"><i></i><i></i><i></i></div>
      <svg class="tb-icon" viewBox="0 0 16 16" aria-hidden="true">
        <rect x="2" y="3" width="12" height="10" rx="2.2" fill="none" stroke="currentColor" stroke-width="1.2" />
        <path d="M6 3v10" stroke="currentColor" stroke-width="1.2" />
      </svg>
      <div class="tabs">
        <span class="tab is-active">Get Started.md</span>
        <span class="tab">Ideas.md</span>
        <span class="tab tab-faint">2026-11-04.md</span>
      </div>
      <div class="tb-actions" aria-hidden="true">
        <svg viewBox="0 0 16 16"><circle cx="3.5" cy="8" r="1.1" /><circle cx="8" cy="8" r="1.1" /><circle cx="12.5" cy="8" r="1.1" /></svg>
      </div>
    </div>

    <div class="body">
      <aside class="sidebar" aria-label="Workspace">
        <div class="ws">
          <span class="ws-name">Notes</span>
          <span class="ws-live" title="Watching for changes"></span>
        </div>
        <ul class="tree">
          {
            files.map((f) => (
              <li class:list={["node", { "is-active": f.active }]} style={`--depth:${f.depth}`}>
                {f.folder ? (
                  <svg viewBox="0 0 16 16" class:list={["chev", { open: f.open }]} aria-hidden="true">
                    <path d="M6 4.5 9.5 8 6 11.5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                ) : (
                  <svg viewBox="0 0 16 16" class="doc" aria-hidden="true">
                    <path d="M4.5 2.5h4.8L12 5.2v8.3H4.5z" fill="none" stroke="currentColor" stroke-width="1.15" stroke-linejoin="round" />
                  </svg>
                )}
                <span>{f.name}</span>
              </li>
            ))
          }
        </ul>
      </aside>

      <div class="panes">
        <div class="editor" aria-label="Editor">
          <ol class="lines">
            {
              source.map((line, i) => (
                <li class={line.kind ?? "text"}>
                  <span class="ln">{i + 1}</span>
                  <span class="src">
                    {tokens(line.text).map((t) => (t.mark ? <span class="mk">{t.text}</span> : t.text))}
                    {i === 13 && <span class="cursor" aria-hidden="true" />}
                  </span>
                </li>
              ))
            }
          </ol>
        </div>

        <div class="divider" aria-hidden="true"><span></span></div>

        <div class="reader" aria-label="Reader">
          <nav class="rail" aria-hidden="true">
            {outline.map((o) => <span class={`mark l${o.level}`} />)}
            <span class="mark l3" />
          </nav>
          <article class="doc-page">
            <h3 class="r-h1">A little space for your thoughts.</h3>
            <p>
              Welcome to <strong>enso</strong>, a quiet home for your Markdown and text files. Changes save automatically.
            </p>
            <h4 class="r-h2">Read. Write. Make room.</h4>
            <blockquote>Simplicity is the space where ideas take shape.</blockquote>
            <ul class="tasks">
              <li><button class="check is-done" aria-label="Open a folder" aria-pressed="true"></button>Open a folder</li>
              <li><button class="check" aria-label="Draft the essay" aria-pressed="false"></button>Draft the essay</li>
              <li><button class="check" aria-label="Sketch the flow" aria-pressed="false"></button>Sketch the flow</li>
            </ul>
            <svg class="diagram" viewBox="0 0 330 64" role="img" aria-label="A Mermaid flowchart: Idea, Draft, Share">
              <defs>
                <marker id="aw-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto">
                  <path d="M0 0 8 4 0 8z" fill="currentColor" />
                </marker>
              </defs>
              {
                ["Idea", "Draft", "Share"].map((label, i) => (
                  <g>
                    <rect x={6 + i * 118} y="14" width="82" height="36" rx="8" />
                    <text x={47 + i * 118} y="36.5">{label}</text>
                  </g>
                ))
              }
              <path d="M90 32h26" stroke="currentColor" stroke-width="1.2" marker-end="url(#aw-arrow)" />
              <path d="M208 32h26" stroke="currentColor" stroke-width="1.2" marker-end="url(#aw-arrow)" />
            </svg>
          </article>
        </div>
      </div>
    </div>

    <div class="status">
      <span class="status-view"></span>
      <span>Saved</span>
      <span class="status-words">38 Words</span>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>(".app").forEach((app) => {
    const tabs = app.querySelectorAll<HTMLButtonElement>("[data-to]");
    const pill = app.querySelector<HTMLElement>(".switch-pill");
    const place = () => {
      const active = app.querySelector<HTMLElement>('[aria-selected="true"]');
      if (!active || !pill) return;
      pill.style.width = `${active.offsetWidth}px`;
      pill.style.transform = `translateX(${active.offsetLeft}px)`;
    };
    let previous = "read";
    const show = (view: string) => {
      if (view === app.dataset.view) return;
      if (view === "split") previous = app.dataset.view ?? "read";
      app.dataset.view = view;
      tabs.forEach((t) => t.setAttribute("aria-selected", String(t.dataset.to === view)));
      place();
    };
    tabs.forEach((tab) => tab.addEventListener("click", () => show(tab.dataset.to!)));

    // The app's own shortcuts, labeled for the visitor's platform: ⌘ on macOS, Ctrl elsewhere
    const mac = /Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent);
    if (!mac) app.querySelectorAll(".mod").forEach((m) => (m.textContent = "Ctrl+"));

    // They work only while the window is on screen, so the browser keeps its own the rest of the time
    let onScreen = false;
    new IntersectionObserver(([entry]) => (onScreen = entry.isIntersecting), { threshold: 0.35 }).observe(
      app.querySelector(".window")!
    );
    window.addEventListener("keydown", (event) => {
      // ⌘ on macOS, where Ctrl works too, as in enso; Ctrl on Windows and Linux
      const mod = mac ? event.metaKey || event.ctrlKey : event.ctrlKey && !event.metaKey;
      if (!onScreen || !mod || event.altKey || event.shiftKey || event.repeat) return;
      const target = event.target as HTMLElement | null;
      if (target?.closest("input, textarea, select, [contenteditable]")) return;
      if (event.code === "KeyE") {
        show(app.dataset.view === "edit" ? "read" : "edit");
      } else if (event.code === "Backslash") {
        show(app.dataset.view === "split" ? previous : "split");
      } else {
        return;
      }
      event.preventDefault();
    });
    app.querySelectorAll<HTMLButtonElement>(".check").forEach((check) =>
      check.addEventListener("click", () => {
        const done = check.classList.toggle("is-done");
        check.setAttribute("aria-pressed", String(done));
      })
    );
    place();
    document.fonts?.ready.then(place);
    window.addEventListener("resize", place);
  });
</script>

<style>
  .app {
    --w-bg: var(--paper-raised);
    --w-side: var(--paper-sunk);
    --w-line: var(--line);
    display: grid;
    justify-items: center;
    gap: 22px;
  }

  /* The view switcher */
  .switch {
    position: relative;
    display: inline-flex;
    padding: 4px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--paper-raised) 70%, transparent);
  }
  .switch-pill {
    position: absolute;
    top: 4px;
    left: 0;
    height: calc(100% - 8px);
    border-radius: 999px;
    background: var(--ink);
    transition:
      transform 0.55s var(--ease),
      width 0.55s var(--ease);
  }
  .switch button {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 34px;
    padding: 0 8px 0 16px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--ink-muted);
    border-radius: 999px;
    transition: color 0.4s var(--ease);
  }
  .switch button[aria-selected="true"] {
    color: var(--paper);
  }
  .switch kbd {
    height: 20px;
    min-width: 0;
    font-size: 11px;
    font-weight: 400;
    color: inherit;
    background: transparent;
    border-color: currentColor;
    border-bottom-width: 1px;
    opacity: 0.45;
  }

  /* The window */
  .window {
    width: 100%;
    display: grid;
    grid-template-rows: 40px minmax(0, 1fr) 22px;
    height: clamp(440px, 44vw, 540px);
    overflow: hidden;
    border-radius: 14px;
    background: var(--w-bg);
    border: 1px solid var(--line-strong);
    box-shadow: var(--shadow);
    font-family: var(--font-sans);
    text-align: left;
  }

  .titlebar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 12px 0 14px;
    border-bottom: 1px solid var(--w-line);
    background: var(--w-side);
  }
  .lights {
    display: flex;
    gap: 8px;
  }
  .lights i {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--line-strong);
  }
  .window:hover .lights i:nth-child(1) {
    background: #ff5f57;
  }
  .window:hover .lights i:nth-child(2) {
    background: #febc2e;
  }
  .window:hover .lights i:nth-child(3) {
    background: #28c840;
  }
  .lights i {
    transition: background-color 0.3s var(--ease);
  }
  .tb-icon {
    width: 16px;
    height: 16px;
    color: var(--ink-soft);
    margin-left: 8px;
  }
  .tabs {
    display: flex;
    gap: 2px;
    min-width: 0;
    overflow: hidden;
    margin-left: 6px;
  }
  .tab {
    flex: none;
    padding: 4px 12px;
    font-size: 12px;
    color: var(--ink-soft);
    border-radius: 999px;
    white-space: nowrap;
  }
  .tab.is-active {
    color: var(--ink);
    background: var(--w-bg);
    box-shadow: 0 0 0 1px var(--w-line);
  }
  .tab-faint {
    opacity: 0.7;
  }
  .tb-actions {
    margin-left: auto;
    color: var(--ink-soft);
  }
  .tb-actions svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  .body {
    display: grid;
    grid-template-columns: 208px minmax(0, 1fr);
    min-height: 0;
  }

  .sidebar {
    padding: 14px 8px;
    background: var(--w-side);
    border-right: 1px solid var(--w-line);
    font-size: 12.5px;
  }
  .ws {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 8px 10px;
  }
  .ws-name {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .ws-live {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ink-faint);
    animation: live 3.6s ease-in-out infinite;
  }
  @keyframes live {
    50% {
      opacity: 0.3;
    }
  }
  .tree {
    list-style: none;
    display: grid;
    gap: 1px;
  }
  .node {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 26px;
    padding: 0 8px 0 calc(6px + var(--depth) * 16px);
    color: var(--ink-muted);
    border-radius: 7px;
    white-space: nowrap;
  }
  .node svg {
    flex: none;
    width: 14px;
    height: 14px;
    color: var(--ink-soft);
  }
  .chev.open {
    transform: rotate(90deg);
  }
  .node.is-active {
    color: var(--ink);
    background: color-mix(in srgb, var(--ink) 7%, transparent);
  }

  /* Panes: editor and reader share the space; the view decides who shows */
  .panes {
    position: relative;
    display: grid;
    grid-template-columns: 0fr 0px 1fr;
    min-height: 0;
    transition: grid-template-columns 0.7s var(--ease);
  }
  [data-view="edit"] .panes {
    grid-template-columns: 1fr 0px 0fr;
  }
  [data-view="split"] .panes {
    grid-template-columns: 1fr 1px 1fr;
  }
  .editor,
  .reader {
    min-width: 0;
    overflow: hidden;
    transition: opacity 0.5s var(--ease);
  }
  [data-view="read"] .editor,
  [data-view="edit"] .reader {
    opacity: 0;
  }
  .divider {
    position: relative;
    background: var(--w-line);
  }
  .divider span {
    position: absolute;
    top: 50%;
    left: -2px;
    width: 5px;
    height: 28px;
    margin-top: -14px;
    border-radius: 3px;
    background: var(--line-strong);
    opacity: 0;
    transition: opacity 0.4s var(--ease);
  }
  [data-view="split"] .divider span {
    opacity: 1;
  }

  /* Editor */
  .editor {
    padding: 22px 0;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 21px;
    color: var(--ink);
  }
  .lines {
    list-style: none;
    min-width: 420px;
  }
  .lines li {
    display: flex;
    white-space: pre;
  }
  .ln {
    flex: none;
    width: 46px;
    padding-right: 16px;
    text-align: right;
    color: var(--ink-faint);
    user-select: none;
  }
  .mk {
    color: var(--ink-soft);
  }
  .h1 .src,
  .h2 .src {
    color: var(--accent-ink);
  }
  .h1 .mk,
  .h2 .mk {
    color: color-mix(in srgb, var(--accent-ink) 55%, transparent);
  }
  .quote .src {
    color: var(--ink-muted);
    font-style: italic;
  }
  .fence .src,
  .code .src {
    color: var(--ink-muted);
  }
  .cursor {
    display: inline-block;
    width: 2px;
    height: 15px;
    margin-left: 1px;
    vertical-align: -3px;
    border-radius: 1px;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  /* Reader */
  .reader {
    position: relative;
    display: flex;
    justify-content: center;
    padding: 34px 40px 0 52px;
  }
  .rail {
    position: absolute;
    top: 40px;
    left: 18px;
    display: grid;
    gap: 7px;
  }
  .mark {
    height: 2px;
    border-radius: 2px;
    background: var(--ink-faint);
    opacity: 0.6;
  }
  .mark.l1 {
    width: 16px;
    background: var(--ink-muted);
  }
  .mark.l2 {
    width: 11px;
  }
  .mark.l3 {
    width: 7px;
  }
  .doc-page {
    width: 100%;
    max-width: 520px;
    font-size: 14px;
    line-height: 1.7;
    color: var(--ink-muted);
  }
  .doc-page strong {
    color: var(--ink);
  }
  .r-h1 {
    margin-bottom: 12px;
    font-family: var(--font-sans);
    font-size: 25px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.025em;
    color: var(--ink);
  }
  .r-h2 {
    margin: 22px 0 10px;
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--ink);
  }
  blockquote {
    padding-left: 14px;
    border-left: 2px solid var(--line-strong);
    font-style: italic;
  }
  .tasks {
    list-style: none;
    display: grid;
    gap: 4px;
    margin: 14px 0 18px;
  }
  .tasks li {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .check {
    position: relative;
    width: 15px;
    height: 15px;
    border: 1.3px solid var(--ink-soft);
    border-radius: 4px;
    transition: background-color 0.25s var(--ease), border-color 0.25s var(--ease);
  }
  .check.is-done {
    background: var(--ink);
    border-color: var(--ink);
  }
  .check.is-done::after {
    content: "";
    position: absolute;
    left: 4px;
    top: 1px;
    width: 4px;
    height: 8px;
    border: solid var(--paper);
    border-width: 0 1.6px 1.6px 0;
    transform: rotate(45deg);
  }
  .tasks li:has(.is-done) {
    color: var(--ink-soft);
    text-decoration: line-through;
    text-decoration-color: var(--ink-faint);
  }
  .diagram {
    width: 100%;
    max-width: 330px;
    color: var(--ink-soft);
  }
  .diagram rect {
    fill: var(--paper-sunk);
    stroke: var(--line-strong);
  }
  .diagram text {
    font-size: 12.5px;
    text-anchor: middle;
    fill: var(--ink);
  }

  .status {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 0 14px;
    font-size: 11px;
    color: var(--ink-soft);
    border-top: 1px solid var(--w-line);
    background: var(--w-side);
  }
  .status-words {
    margin-left: auto;
  }
  .status-view::before {
    content: "Read";
  }
  [data-view="edit"] .status-view::before {
    content: "Edit";
  }
  [data-view="split"] .status-view::before {
    content: "Split";
  }

  @media (max-width: 900px) {
    .body {
      grid-template-columns: minmax(0, 1fr);
    }
    .sidebar {
      display: none;
    }
    .reader {
      padding: 26px 22px 0 40px;
    }
    .rail {
      left: 14px;
      top: 32px;
    }
  }
  @media (max-width: 640px) {
    .switch button {
      padding: 0 14px;
    }
    .switch kbd {
      display: none;
    }
    .window {
      height: 500px;
      border-radius: 12px;
    }
    .tab:not(.is-active),
    .tb-icon {
      display: none;
    }
    /* Split stacks the editor above the reader on a phone */
    .panes,
    [data-view="edit"] .panes,
    [data-view="split"] .panes {
      grid-template-columns: 1fr;
      grid-template-rows: 0fr 0px 1fr;
      transition: grid-template-rows 0.7s var(--ease);
    }
    [data-view="edit"] .panes {
      grid-template-rows: 1fr 0px 0fr;
    }
    [data-view="split"] .panes {
      grid-template-rows: 1fr 1px 1fr;
    }
    .divider span {
      display: none;
    }
    .editor {
      padding: 14px 0;
      font-size: 11px;
      line-height: 19px;
    }
    .ln {
      width: 34px;
      padding-right: 12px;
    }
    .reader {
      padding: 22px 18px 0 30px;
    }
    .rail {
      left: 10px;
      top: 28px;
    }
    .r-h1 {
      font-size: 21px;
    }
    .doc-page {
      font-size: 13.5px;
    }
  }
</style>
