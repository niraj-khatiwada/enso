---
/** enso's logo, in ink on paper or chalk on night, following the page's theme */
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: className } = Astro.props;
const src = size > 48 ? 128 : 64;
---

<span class:list={["logo", className]} style={`--size:${size}px`} aria-hidden="true">
  <img class="logo-light" src={`/logo-dark-${src}.png`} alt="" width={size} height={size} />
  <img class="logo-dark" src={`/logo-light-${src}.png`} alt="" width={size} height={size} />
</span>

<style>
  .logo {
    position: relative;
    display: inline-block;
    width: var(--size);
    height: var(--size);
    flex: none;
  }
  .logo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transition: opacity 0.4s var(--ease);
  }
  .logo-dark {
    opacity: 0;
  }
  :global([data-theme="dark"]) .logo-light {
    opacity: 0;
  }
  :global([data-theme="dark"]) .logo-dark {
    opacity: 1;
  }
</style>
